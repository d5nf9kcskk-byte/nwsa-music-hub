rules_version = '2';

// NWSA Music Hub — Firestore security rules
//
// Three tiers of data:
//   • PUBLIC collections are world-readable (they power the public site:
//     schedules, repertoire, announcements). They contain no private contact
//     info. Only staff (Owner/Director) may write them.
//   • PRIVATE collections (full student records, contact details, attendance
//     exceptions, progress notes, private lessons) are readable and writable
//     only by signed-in staff — never world-readable.
//   • PAID-ROSTER collections (#personnel: personnel, personnelContacts,
//     contracts, contractTemplates — Fair Copy adult orgs) are stricter
//     still: Owner/Director
//     only, exact key allowlists, and NO public projection exists or may be
//     added. See the section header above /personnel below.
//
// Student privacy (#privacy): the full `students` and `rosterOverrides`
// collections are staff-only. The public site reads projection mirrors
// instead — `studentsPublic` (name, preferred name, instrument, section,
// ensembles, status, grade; NEVER pronunciation or contacts) and
// `rosterOverridesPublic` (every field EXCEPT the free-text reason).
// Mirrors are batched with each write (src/director/publicMirror.ts) and
// converged by scripts/backfill-public-projections.mjs via the Admin SDK.
//
// Five access levels (#roles), stored on each directors/{email} doc as
// `roles: string[]` (one person may hold several — e.g. director + teacher).
// Legacy docs still have a single `role` field; rules read both until migrated.
//   • owner     — exactly one account. The only one that can add/remove a
//                 director or change anyone's role.
//   • director  — full edit access to everything except the Directors list.
//   • teacher   — the APPLIED TEACHER (#applied): a private studio/instrument
//                 teacher, scoped to their OWN assigned students — scheduling
//                 and GRADING their own lessons (see `lessons` and the
//                 `kind == 'lesson'` exception on `rosterOverrides` below).
//                 Can't touch rosters, schedule, repertoire, documents,
//                 announcements, contacts, or the Directors list.
//                 The label reads "Applied Teacher" everywhere in the app;
//                 the STORED value is still 'teacher' and must stay that way.
//                 Renaming it would mean migrating every live directors doc
//                 while these rules temporarily accepted BOTH strings — i.e.
//                 widening the closed role set, the one thing this comment
//                 block exists to prevent. Words are a UI concern
//                 (STAFF_ROLE_LABEL in src/director/types.ts); the wire value
//                 is a rules contract.
//   • assistant — Personnel Assistant: reads/writes ATTENDANCE only, and only
//                 for the ensembles named in their doc's `assignedEnsembleIds`
//                 (plus the narrow side-effects of taking roll: the event's
//                 rollTaken receipt, lesson pull-out overrides, and reading
//                 planned absences). Never contacts, notes, grades, or any
//                 public-collection write.
// A doc with no `role`/`roles` predates this feature and is treated as a full
// director (see isStaff()) — nobody with existing access loses it. An
// EXPLICIT but unrecognized role is fail-closed: beyond reading and
// renaming its own directors doc, it can touch nothing (every data rule
// requires one of the four roles above — see isKnownRole()). A future
// fifth role must be added to these rules deliberately before its
// accounts gain any access.
//
// The AI enrichment GitHub Action authenticates with a service account via the
// Admin SDK, which bypasses these rules entirely — so enrichment writes work
// regardless of what's below.
//
// Deploy with:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function myDirectorDoc() {
      return get(/databases/$(database)/documents/directors/$(request.auth.token.email)).data;
    }

    // A director is an authenticated user who has a doc in the `directors`
    // collection (doc id = their lowercased Google sign-in email). Google
    // sign-in lets ANY Google account authenticate, so checking only
    // `request.auth != null` would expose student contact info, attendance,
    // and progress notes to anyone who finds the URL.
    //
    // The allowlist lives in DATA (see the `directors` match block below), not
    // in this file — so a director is added or removed from inside the app with
    // NO rules redeploy. That closes the old trap where the app's sign-in mirror
    // shipped automatically but this file had to be deployed by hand, leaving a
    // newly-added director able to open the app but unable to save.
    // email_verified: Google sign-in always verifies, so this costs existing
    // accounts nothing — it only closes the door on a future auth provider
    // (or a forged federated account) presenting an unverified claim to an
    // email that happens to be on the allowlist.
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/directors/$(request.auth.token.email));
    }

    // Same verified-email bar as signedIn(), minus the allowlist existence
    // check — for the directors block's self-service paths, where the doc
    // being read IS the membership answer (a clean "not a director" must
    // surface as doc-not-exists, never as permission-denied).
    function verifiedSelf(email) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == email;
    }

    // Does the signed-in user's directors doc include role `r`? Reads the
    // new `roles[]` array when present; falls back to legacy single `role`.
    function hasRole(r) {
      let d = myDirectorDoc();
      return signedIn() && (
        (d.keys().hasAny(['roles']) && r in d.get('roles', []))
        || (!d.keys().hasAny(['roles']) && d.get('role', 'director') == r)
      );
    }

    // The Owner: the one account allowed to manage the Directors list itself.
    function isOwner() {
      return hasRole('owner');
    }

    function isTeacherRole() {
      return hasRole('teacher');
    }

    function isClassroomRole() {
      return hasRole('classroom');
    }

    // Personnel Assistant (#roles): attendance-only, for assigned ensembles.
    function isAssistantRole() {
      return hasRole('assistant');
    }

    // Shared `assignedEnsembleIds` scoping — assistants (performing ensembles)
    // and classroom teachers (class sections) both use this field.
    function assignedCovers(ensembleId) {
      return (isAssistantRole() || isClassroomRole())
        && ensembleId in myDirectorDoc().get('assignedEnsembleIds', []);
    }

    // Is `ensembleId` one of the signed-in assistant's assigned ensembles?
    function assistantCovers(ensembleId) {
      return assignedCovers(ensembleId) && isAssistantRole();
    }

    // Is `studentId` on the signed-in Applied Teacher's assigned list?
    // Used to narrow contacts + lesson-log mail to their own studio only.
    function teacherAssignedTo(studentId) {
      return isTeacherRole()
        && studentId in myDirectorDoc().get('assignedStudentIds', []);
    }

    function classroomCoversAny(ensembleIds) {
      return isClassroomRole()
        && ensembleIds.hasAny(myDirectorDoc().get('assignedEnsembleIds', []));
    }

    function classroomCoversAssignmentId(assignmentId) {
      let a = get(/databases/$(database)/documents/assignments/$(assignmentId)).data;
      return classroomCoversAny(a.get('ensembleIds', []));
    }

    // Full director privileges: Owner, Director, or a legacy doc with no
    // role set (every director created before roles existed — the default
    // fills in 'director' for those). Fail-CLOSED for anything else,
    // instead of silently inheriting full director rights the way the old
    // "not teacher && not assistant" check did.
    function isStaff() {
      return hasRole('owner') || hasRole('director');
    }

    // Any of the four recognized roles (legacy no-role docs count as
    // director). Shared-tier rules below are gated on THIS, never on bare
    // signedIn(), so an explicit unknown role gets nothing: a future fifth
    // role must be added here deliberately before its accounts can read
    // students, rosters, or logs.
    function isKnownRole() {
      return hasRole('owner') || hasRole('director') || hasRole('teacher')
        || hasRole('classroom') || hasRole('assistant');
    }

    // Sign-in / activity logs carry one `role` label — it must be one of
    // the roles on the directors doc, not whatever the client picks.
    function roleClaimValid(claimed) {
      let d = myDirectorDoc();
      return (d.keys().hasAny(['roles']) && claimed in d.get('roles', []))
        || (!d.keys().hasAny(['roles']) && claimed == d.get('role', 'director'));
    }

    // Sign-up invite lists live in staff-only signupAudiences/{formId} — never
    // on the world-readable signupForms doc (#signups / signupEligibility.ts).
    function signupStudentAllowed(formId, studentId) {
      let form = get(/databases/$(database)/documents/signupForms/$(formId)).data;
      return form.get('audienceMode', 'groups') != 'students'
        || (exists(/databases/$(database)/documents/signupAudiences/$(formId))
            && studentId in get(/databases/$(database)/documents/signupAudiences/$(formId)).data.studentIds);
    }

    // ── Public read · staff write ────────────────────
    match /ensembles/{doc}       { allow read; allow write: if isStaff(); }
    // Full student records (pronunciation, …) are staff-eyes only
    // (#privacy). Every recognized role may READ them — teachers need
    // names for lessons, assistants need pronunciation for roll — but the
    // public site gets only the studentsPublic projection below.
    match /students/{doc}        { allow read: if isKnownRole(); allow write: if isStaff(); }
    // Public projection of the roster: name, preferredName, instrument,
    // section, ensembleIds, status, grade — nothing else. Written in the same
    // batch as the source doc by staff clients.
    match /studentsPublic/{doc} {
      allow read;
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(
             ['name', 'preferredName', 'instrument', 'section', 'ensembleIds', 'status', 'grade']);
      allow delete: if isStaff();
    }
    // events: staff edit freely. A Personnel Assistant may update ONLY the
    // rollTaken receipt (the side-effect of finishing roll) — never the
    // schedule itself — and only the receipt entries for THEIR ensembles.
    match /events/{doc} {
      allow read;
      allow create, delete: if isStaff();
      allow update: if isStaff()
        || (isAssistantRole()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rollTaken'])
            && request.resource.data.rollTaken
                 .diff(resource.data.get('rollTaken', {}))
                 .affectedKeys()
                 .hasOnly(myDirectorDoc().get('assignedEnsembleIds', [])));
    }
    // Saved calendar views (#subscribe-any-view): the filter mixes the deploy
    // step turns into subscribable ICS feeds. World-readable, and written by
    // ANYONE — a student picking their own three ensembles on the public
    // calendar is the main audience, and a live subscription for that mix is
    // the entire point of the feature, so this is an unauthenticated create
    // like plannedAbsences and parentMessages, with the same strictest-
    // validation treatment: exact key set, closed type enum, bounded lists
    // and label.
    //
    // A view doc carries no personal information — a list of ensemble ids and
    // event types, all of them already world-readable. Two structural guards
    // do the rest of the work:
    //   • the doc ID is a hash of the filters themselves (viewSlug), so
    //     re-subscribing to the same mix rewrites ONE doc instead of piling
    //     up new ones;
    //   • generate-feeds.mjs recomputes that hash and ignores any doc whose
    //     ID does not match its own contents, so a squatted ID can only ever
    //     hold the correct filters — and the next real subscriber overwrites
    //     it (hence create AND update).
    // Volume rate-limiting still needs App Check or a Cloud Function and is
    // deferred, matching the stance on the other public writes
    // (docs/security-recommendations.md).
    match /calendarViews/{doc} {
      allow read;
      allow delete: if isStaff();
      allow create, update: if request.resource.data.keys().hasOnly(
            ['ensembleIds', 'school', 'types', 'label', 'updatedAt'])
        && request.resource.data.ensembleIds is list
        && request.resource.data.ensembleIds.size() <= 40
        && request.resource.data.school is bool
        && request.resource.data.types is list
        && request.resource.data.types.size() <= 12
        && request.resource.data.types.hasOnly(
             ['Class', 'Rehearsal', 'Sectional', 'Concert', 'Event', 'Assignment'])
        && request.resource.data.label is string
        && request.resource.data.label.size() <= 200
        && request.resource.data.updatedAt is number;
    }
    // rosterOverrides: staff can write anything. A Teacher may create/edit/
    // delete only THEIR OWN private-lesson pull-outs (kind == 'lesson') — the
    // automatic side effect of scheduling a lesson that conflicts with a
    // rehearsal/class (see the `lessons` collection below). Teachers never
    // touch ordinary subs/pull-outs or another teacher's lesson entries.
    // A Personnel Assistant gets the same lesson-only exception (the Lesson
    // button on Take Roll records a pull-out window) — scoped to the
    // ensembles they cover.
    match /rosterOverrides/{doc} {
      // Staff-only reads (#privacy): override docs carry a free-text `reason`
      // directors may fill with sensitive context. The public site reads the
      // reason-free rosterOverridesPublic mirror below instead.
      allow read: if isKnownRole();
      allow create: if isStaff()
        || (isTeacherRole() && request.resource.data.kind == 'lesson')
        || (request.resource.data.kind == 'lesson' && assignedCovers(request.resource.data.ensembleId));
      allow update: if isStaff()
        || (isTeacherRole() && resource.data.kind == 'lesson' && request.resource.data.kind == 'lesson')
        || (resource.data.kind == 'lesson' && request.resource.data.kind == 'lesson'
            && assignedCovers(resource.data.ensembleId)
            && request.resource.data.ensembleId == resource.data.ensembleId);
      allow delete: if isStaff()
        || (isTeacherRole() && resource.data.kind == 'lesson')
        || (resource.data.kind == 'lesson' && assignedCovers(resource.data.ensembleId));
    }
    // Reason-free public mirror of rosterOverrides (#privacy): the public
    // student-schedule page shows lesson pull-out windows and sub/pull roster
    // effects from here. Writers are the same clients that write the source
    // collection (all allowlisted roles — teachers and assistants create
    // lesson pull-outs); the shape check makes a leaked `reason` impossible
    // regardless of client code.
    // Public projection of roster overrides: every field EXCEPT the free-text
    // `reason`. The key list is FROZEN here, mirroring publicOverrideFields()
    // in src/director/publicMirror.ts — denying `reason` alone left any
    // recognized role (teachers and assistants write lesson pull-outs here)
    // able to add arbitrary extra keys to a world-readable doc (audit rec #3).
    // Adding a field to RosterOverride now means adding it here in the same
    // change; rules auto-deploy on merge to main, so the two ship together.
    match /rosterOverridesPublic/{doc} {
      allow read;
      allow create, update: if isKnownRole()
        && request.resource.data.keys().hasOnly([
             'studentId', 'ensembleId', 'action', 'scope',
             'eventId', 'startDate', 'endDate',
             'startTime', 'endTime', 'kind', 'destEnsembleId', 'days',
           ]);
      allow delete: if isKnownRole();
    }
    match /announcements/{doc}   { allow read; allow write: if isStaff(); }
    // Staff heads-up notices (#two-doors §5.1): saving a student move drops a
    // notice for the affected ensembles' directors. Staff-only READ — the text
    // names students. Creators mirror rosterOverrides (any known role may save
    // a move there). Dismiss is PER-PERSON (readBy), so update may touch only
    // that field — and delete stays a full-director cleanup, never a way for
    // one account to wipe a notice off everyone else's Today.
    match /staffNotices/{doc} {
      allow read, create: if isKnownRole();
      allow update: if isKnownRole()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
      allow delete: if isStaff();
    }
    match /repertoire/{doc}      { allow read; allow write: if isStaff(); }
    // Assignment DEFINITIONS (title, type, due date, target) are public so
    // students see what's assigned. Individual RESULTS/grades stay private below.
    match /assignments/{doc} {
      allow read;
      allow create: if isStaff()
        || classroomCoversAny(request.resource.data.get('ensembleIds', []));
      allow update: if isStaff()
        || (classroomCoversAny(resource.data.get('ensembleIds', []))
            && classroomCoversAny(request.resource.data.get('ensembleIds', [])));
      allow delete: if isStaff()
        || classroomCoversAny(resource.data.get('ensembleIds', []));
    }
    match /seatingCharts/{doc}   { allow read; allow write: if isStaff(); }
    match /locations/{doc}       { allow read; allow write: if isStaff(); }
    // Document repository (syllabi, handbooks, forms). Metadata is public so the
    // Documents page and per-ensemble lists can render; the files themselves
    // live in Storage. Only staff may add/edit/remove entries.
    match /documents/{doc} {
      allow read;
      allow create: if isStaff()
        || classroomCoversAny(request.resource.data.get('ensembleIds', []));
      allow update: if isStaff()
        || (classroomCoversAny(resource.data.get('ensembleIds', []))
            && classroomCoversAny(request.resource.data.get('ensembleIds', [])));
      allow delete: if isStaff()
        || classroomCoversAny(resource.data.get('ensembleIds', []));
    }
    // Sign-up FORMS (#signups): "tell me you want to do All-State, and fill
    // out the paperwork while you're here." World-readable because the public
    // sign-up page has to render the form before anyone identifies
    // themselves. A form carries no personal data: a title, an intro, the
    // director's own questions, and an audience expressed as ensembles +
    // instrument families — never a list of student ids, which would publish
    // who was invited to what (see src/shared/signupEligibility.ts).
    match /signupForms/{doc}     { allow read; allow write: if isStaff(); }

    // Staff-only explicit invite list for a sign-up (#signups). Never
    // world-readable — publishing who was invited would leak through
    // student doc ids shared with studentsPublic.
    match /signupAudiences/{formId} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['studentIds'])
        && request.resource.data.studentIds is list
        && request.resource.data.studentIds.size() <= 500;
      allow delete: if isStaff();
    }

    // Interview time slots on sign-ups (#signups): world-readable so students
    // see "Taken" before they send. Create-only, one doc per slot, doc id =
    // formId__questionId__slotIndex — the client transaction checks the slot
    // is free (or already held by the same student re-submitting).
    match /signupSlotBookings/{bookingId} {
      allow read;
      allow create: if !exists(/databases/$(database)/documents/signupSlotBookings/$(bookingId))
        && request.resource.data.keys().hasOnly([
              'formId', 'questionId', 'slotIndex', 'slotLabel',
              'studentId', 'studentName', 'submittedAt'])
        && request.resource.data.formId is string
        && exists(/databases/$(database)/documents/signupForms/$(request.resource.data.formId))
        && get(/databases/$(database)/documents/signupForms/$(request.resource.data.formId))
             .data.get('closed', false) == false
        && request.resource.data.questionId is string
        && request.resource.data.questionId.size() <= 40
        && request.resource.data.slotIndex is int
        && request.resource.data.slotIndex >= 0
        && request.resource.data.slotIndex <= 200
        && request.resource.data.slotLabel is string
        && request.resource.data.slotLabel.size() >= 1
        && request.resource.data.slotLabel.size() <= 200
        && request.resource.data.studentId is string
        && exists(/databases/$(database)/documents/students/$(request.resource.data.studentId))
        && signupStudentAllowed(request.resource.data.formId, request.resource.data.studentId)
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() >= 2
        && request.resource.data.studentName.size() <= 120
        && request.resource.data.submittedAt is number
        && bookingId == request.resource.data.formId + '__'
             + request.resource.data.questionId + '__'
             + string(request.resource.data.slotIndex);
      allow update: if false;
      allow delete: if isStaff();
    }

    // Planned absences (#27): anyone may SUBMIT one (create-only, shape-checked),
    // but only staff can read the queue or change/delete entries — so the
    // public side can't enumerate or tamper with other students' reports.
    match /plannedAbsences/{doc} {
      // Hardened shape (audit S4): the student must actually exist (no
      // spam-for-invented-ids), the date must be a real YYYY-MM-DD string,
      // and every free-text field is size-bounded — this was the FIRST
      // unauthenticated write in the app and set the standard the other four
      // (parentMessages, assignmentSubmissions, calendarViews,
      // signupResponses) are held to.
      allow create: if request.resource.data.keys().hasOnly(['studentId', 'studentName', 'date', 'reason', 'submittedAt', 'status'])
        && request.resource.data.studentId is string
        && exists(/databases/$(database)/documents/students/$(request.resource.data.studentId))
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() <= 120
        && request.resource.data.date is string
        && request.resource.data.date.matches('\\d{4}-\\d{2}-\\d{2}')
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 300
        && request.resource.data.submittedAt is number
        && request.resource.data.status == 'pending';
      // Assistants read the queue too — Take Roll shows "reported ahead"
      // chips so they can accept a planned absence as Excused.
      allow read: if isStaff() || isAssistantRole();
      allow update, delete: if isStaff();
    }

    match /parentMessages/{doc} {
      // Parent→staff contact form (#parent-messages): an unauthenticated
      // create (like plannedAbsences and assignmentSubmissions), so it
      // gets the same strictest-validation
      // treatment as plannedAbsences — exact key set, closed topic enum,
      // size floors AND ceilings on every free-text field. keys().hasOnly
      // doubles as the honeypot: the form only includes its hidden decoy
      // field when a bot fills it, and the create is rejected here.
      // Deliberately NO students/{id} anchor — prospective families (no
      // student doc yet) are a primary audience for this form. Real rate
      // limiting needs App Check or a Cloud Function (Blaze) and is
      // deferred, matching the plannedAbsences stance
      // (docs/security-recommendations.md).
      allow create: if request.resource.data.keys().hasOnly(
            ['parentName', 'email', 'studentName', 'topic', 'message', 'submittedAt', 'status'])
        && request.resource.data.parentName is string
        && request.resource.data.parentName.size() >= 2
        && request.resource.data.parentName.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('.+@.+\\..+')
        && (!('studentName' in request.resource.data)
            || (request.resource.data.studentName is string
                && request.resource.data.studentName.size() <= 120))
        && request.resource.data.topic in
            ['attendance', 'schedule', 'lessons', 'concerts', 'volunteer', 'enrollment', 'other']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 1000
        && request.resource.data.submittedAt is number
        && request.resource.data.status == 'new';
      allow read: if isStaff();
      allow update, delete: if isStaff();
    }

    // Sign-up RESPONSES (#signups): a student saying "yes, I want to do this",
    // plus whatever the form asked for and a typed signature. The app's fifth
    // unauthenticated create (with plannedAbsences, parentMessages,
    // assignmentSubmissions and calendarViews) — students have no accounts, so
    // requiring auth would kill the feature — and it gets the same
    // strictest-validation treatment: exact key set, an anchor to a real
    // student AND a real sign-up, and a ceiling on every free-text field.
    //
    // Two deliberate shapes:
    //   • Answers ride in ONE bounded `answersJson` string rather than a map.
    //     Rules can bound a string's length but cannot reach inside a map to
    //     bound its values, and an unauthenticated writer must not be able to
    //     park 900 KB in a field nobody checked.
    //   • There is NO public update. An unauthenticated update rule would let
    //     anyone overwrite anyone else's signed form; a student who comes back
    //     to finish the paperwork creates a second doc and the director's
    //     screen keeps the newest (latestPerStudent in useSignups.ts).
    //
    // The sign-up must still be OPEN — the closed flag is checked here, not
    // just in the UI, so closing a sign-up actually stops new responses.
    // Volume rate-limiting still needs App Check or a Cloud Function and is
    // deferred, matching the stance on the other public writes
    // (docs/security-recommendations.md).
    match /signupResponses/{doc} {
      allow create: if request.resource.data.keys().hasOnly([
            'formId', 'studentId', 'studentName', 'grade', 'instrument',
            'email', 'phone', 'answersJson', 'signature',
            'guardianName', 'guardianSignature', 'guardianEmail',
            'submittedAt', 'status'])
        && request.resource.data.formId is string
        && exists(/databases/$(database)/documents/signupForms/$(request.resource.data.formId))
        && get(/databases/$(database)/documents/signupForms/$(request.resource.data.formId))
             .data.get('closed', false) == false
        && request.resource.data.studentId is string
        && exists(/databases/$(database)/documents/students/$(request.resource.data.studentId))
        && signupStudentAllowed(request.resource.data.formId, request.resource.data.studentId)
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() >= 2
        && request.resource.data.studentName.size() <= 120
        && request.resource.data.grade is string
        && request.resource.data.grade.size() <= 40
        && (!('instrument' in request.resource.data)
            || (request.resource.data.instrument is string
                && request.resource.data.instrument.size() <= 60))
        && (!('email' in request.resource.data)
            || (request.resource.data.email is string
                && request.resource.data.email.size() <= 254
                && request.resource.data.email.matches('.+@.+\\..+')))
        && (!('phone' in request.resource.data)
            || (request.resource.data.phone is string
                && request.resource.data.phone.size() <= 40))
        && (!('answersJson' in request.resource.data)
            || (request.resource.data.answersJson is string
                && request.resource.data.answersJson.size() <= 4000))
        && (!('signature' in request.resource.data)
            || (request.resource.data.signature is string
                && request.resource.data.signature.size() <= 120))
        && (!('guardianName' in request.resource.data)
            || (request.resource.data.guardianName is string
                && request.resource.data.guardianName.size() <= 120))
        && (!('guardianSignature' in request.resource.data)
            || (request.resource.data.guardianSignature is string
                && request.resource.data.guardianSignature.size() <= 120))
        && (!('guardianEmail' in request.resource.data)
            || (request.resource.data.guardianEmail is string
                && request.resource.data.guardianEmail.size() <= 254
                && request.resource.data.guardianEmail.matches('.+@.+\\..+')))
        && request.resource.data.submittedAt is number
        && request.resource.data.status == 'submitted';
      // A response names a student, their grade, a contact address and a
      // signature — staff-eyes only, and never listable by the public side.
      allow read: if isStaff();
      allow update, delete: if isStaff();
    }

    // Outbound notification queue (#21): staff-only writes; Power Automate
    // reads it with a service credential (Admin SDK bypasses rules).
    match /notifyQueue/{doc}     { allow read, write: if isStaff(); }
    // Ambiguous rows from the daily office Attendance Bulletin (Admin SDK
    // writes; directors read / dismiss / resolve in Who's Out).
    match /bulletinQueue/{doc}   { allow read, write: if isStaff(); }
    // Parent/student absence emails the local Mail.app pipeline couldn't
    // confidently match (no roster name, more than one name, or an unclear
    // date). A confident match skips this queue entirely and writes straight
    // to plannedAbsences instead. Admin SDK writes; directors read / dismiss
    // in Who's Out, same shape as bulletinQueue.
    match /absenceEmailQueue/{doc} { allow read, write: if isStaff(); }
    // Late to SCHOOL, from the same bulletin pull (#tardies). Staff-only, and
    // NEVER mirrored publicly: it is a per-student disciplinary-adjacent fact,
    // squarely in the same class as attendance and notes (see the projection
    // model in CLAUDE.md). Admin SDK writes it; directors read and annotate.
    match /schoolDayTardies/{doc} { allow read, write: if isStaff(); }
    // Juries (#juries) — staff-only while this is a stub. It names students
    // and a running order; nothing about it is public, and no public surface
    // reads it, so it stays behind the allowlist until there is a reason not to.
    match /juries/{doc} { allow read, write: if isStaff(); }

    // Private lessons (#roles, #applied): an Applied Teacher schedules, edits,
    // cancels and GRADES their OWN lessons; Owner/Director can see and manage
    // all of them (coordination — e.g. confirming a conflict with the ensemble
    // director). Never world-readable, since it names an individual student,
    // their teacher, and now that student's mark.
    //
    // The grade deliberately lives on THIS doc rather than in a grades
    // collection: a lesson is already scoped to exactly one applied teacher,
    // so the grade inherits that scoping and there is no second
    // query/rule pair to keep in agreement.
    match /lessons/{doc} {
      // Not plain signedIn(): a Personnel Assistant is attendance-only and
      // has no business reading who takes private lessons with whom.
      //
      // A Teacher reads only their OWN lessons (audit rec #5) — every teacher
      // could previously read every other teacher's schedule. Rules match per
      // document, so a LIST for a teacher only succeeds if the query itself
      // filters to teacherEmail == their address; useLessons.ts issues exactly
      // that query for the teacher role. Owner/Director still read all of it
      // for coordination.
      allow read: if isStaff()
        || (isTeacherRole() && resource.data.teacherEmail == request.auth.token.email);
      allow create: if isStaff() || (isTeacherRole() && request.resource.data.teacherEmail == request.auth.token.email);
      allow delete: if isStaff() || (isTeacherRole() && resource.data.teacherEmail == request.auth.token.email);
      // Update checks BOTH the old and the new teacherEmail: owning the doc
      // gets you the edit, but the edit may not hand the doc (and the grade on
      // it) to a different teacher, or to an address that is nobody's. Only
      // checking `resource` let a teacher reassign their own lesson away.
      allow update: if isStaff()
        || (isTeacherRole()
            && resource.data.teacherEmail == request.auth.token.email
            && request.resource.data.teacherEmail == resource.data.teacherEmail);
    }

    // ── Private · staff read + write only ──────────────
    // Feed secrets (#lessons-feed): the unguessable token in the private
    // lessons calendar's URL. Staff-only — the token IS the access control on
    // that feed, so it must never reach a public surface or the app bundle.
    // The deploy-time feed generator reads it with the service account, which
    // bypasses these rules.
    match /feedSecrets/{doc}        { allow read, write: if isStaff(); }
    // Contacts: staff read/write; an Applied Teacher may READ only their
    // assigned students' contacts (family summary email after a lesson log).
    // Doc id === student id. Teachers never write contacts.
    match /contacts/{studentId} {
      allow read: if isStaff() || teacherAssignedTo(studentId);
      allow write: if isStaff();
    }
    // Lesson-log family email queue (#applied). Teacher creates a summary
    // after a complete log line; Power Automate (or mailto fallback) sends it.
    // Staff mark processedAt. Never public.
    match /lessonLogMailQueue/{doc} {
      allow read: if isStaff();
      allow create: if isStaff()
        || (isTeacherRole()
            && request.resource.data.teacherEmail == request.auth.token.email
            && teacherAssignedTo(request.resource.data.studentId));
      allow update, delete: if isStaff();
    }
    // attendance: staff freely; assistants and classroom teachers read all
    // (roll needs same-day context) but write only for assigned ensembles.
    match /attendance/{doc} {
      allow read: if isStaff() || isAssistantRole() || isClassroomRole();
      allow create: if isStaff() || assignedCovers(request.resource.data.ensembleId);
      allow update: if isStaff()
        || (assignedCovers(resource.data.ensembleId)
            && request.resource.data.ensembleId == resource.data.ensembleId);
      allow delete: if isStaff() || assignedCovers(resource.data.ensembleId);
    }
    match /progressNotes/{doc}      { allow read, write: if isStaff(); }
    match /assignmentResults/{doc} {
      allow read: if isStaff()
        || (isClassroomRole() && classroomCoversAssignmentId(resource.data.assignmentId));
      allow create: if isStaff()
        || (isClassroomRole() && classroomCoversAssignmentId(request.resource.data.assignmentId));
      allow update: if isStaff()
        || (isClassroomRole()
            && classroomCoversAssignmentId(resource.data.assignmentId)
            && classroomCoversAssignmentId(request.resource.data.assignmentId));
      allow delete: if isStaff()
        || (isClassroomRole() && classroomCoversAssignmentId(resource.data.assignmentId));
    }

    // ── Student video submissions (#video-submissions) ──
    // Students submit video recordings/upload for Playing Exam assignments
    // from the public site (unauthenticated). Staff review them in the
    // grade sheet. A cron GitHub Action syncs them to Google Drive.
    match /assignmentSubmissions/{doc} {
      allow read: if isStaff()
        || (isClassroomRole() && classroomCoversAssignmentId(resource.data.assignmentId));
      // Unauthenticated create with strict shape validation — same pattern
      // as plannedAbsences: must reference a real assignment that accepts
      // video, a real student from that assignment's ensembles, and
      // every field is size-bounded.
      allow create: if request.resource.data.keys().hasOnly([
            'assignmentId', 'studentId', 'studentName', 'status',
            'videoUrl', 'videoDurationSeconds', 'videoThumbnailUrl',
            'fileName', 'fileSize', 'notes', 'submittedAt',
            'googleDriveFileId', 'googleDriveFolderId',
          ])
        && request.resource.data.assignmentId is string
        && exists(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId))
        && get(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId)).data.acceptsVideoSubmissions == true
        && request.resource.data.studentId is string
        && exists(/databases/$(database)/documents/students/$(request.resource.data.studentId))
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() <= 120
        && request.resource.data.status == 'submitted'
        && request.resource.data.videoUrl is string
        && request.resource.data.videoUrl.size() <= 1024
        // >= 0, not > 0: a browser cannot always read the length of a video
        // file a student picked from their phone, and 0 means "unknown", not
        // "empty". Requiring a positive number here is what made every upload
        // (and, before the recorder's timer was fixed, every recording) fail
        // with "Missing or insufficient permissions". File size below still
        // has to be positive, which is the check that actually proves a video.
        && request.resource.data.videoDurationSeconds is number
        && request.resource.data.videoDurationSeconds >= 0
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() <= 256
        && request.resource.data.fileSize is number
        && request.resource.data.fileSize > 0
        && request.resource.data.submittedAt is number;
      // Only staff may update (review status, Drive sync fields) or delete.
      allow update, delete: if isStaff();
    }

    // ── Paid roster & contracts (#personnel — Fair Copy adult orgs) ─────
    // The adult professional roster (Alpharetta Symphony demo, and any
    // future per-service org). The app gates these screens on
    // ORG.features.personnel; the rules ship to every org's project, where
    // the collections simply stay empty for the school orgs.
    //
    // This is the file's THIRD sensitivity tier, above student data
    // (#privacy). Pay rates and tax status were designed fresh here, NOT
    // copied from the students block (docs/fair-copy/as-demo-plan.md), and
    // four decisions define the tier:
    //
    //   • NO public projection. The public site never reads any of these
    //     collections, and no `personnelPublic` mirror exists. If a printed
    //     concert-program roster is ever wanted on the public site, that is
    //     a new, deliberately-designed mirror with its own pinned allowlist
    //     — never a relaxation of a read rule here.
    //   • NO unauthenticated write path. The app's five public writes
    //     (plannedAbsences, parentMessages, assignmentSubmissions,
    //     calendarViews, signupResponses) stay the only five. A future
    //     "musician signs their contract online" flow must be an
    //     authenticated or Cloud Function path — an unauthenticated write
    //     into a collection that carries pay is off the table, even
    //     shape-checked, because the signature IS the sensitive act.
    //   • Owner/Director ONLY — isStaff(), never isKnownRole(). A Teacher
    //     or Personnel Assistant has no business in pay, tax, or adult
    //     contact data. If an adult org ever needs a finer role (a
    //     bookkeeper who sees contracts but not attendance, say), that is a
    //     new fifth role added to isKnownRole() and granted access here
    //     deliberately, per the #roles pattern — it does not fall out of
    //     any existing rule.
    //   • Every doc shape is PINNED to an exact key allowlist mirroring
    //     src/director/types.ts. Staff-only collections normally skip shape
    //     checks (students, contacts — staff clients are trusted), but here
    //     the allowlist is a structural guard, not spam control: pay can
    //     never creep onto the roster doc, and — the one that really
    //     matters — no client, buggy or compromised, can ever add a
    //     taxpayer-id field to personnelContacts. A TIN (SSN/EIN) must
    //     never be stored in Firestore in any field; `w9Status` tracks the
    //     paperwork instead (see the PersonnelContact comment in types.ts).
    //     Adding a field to these types means adding it here in the SAME
    //     change; rules auto-deploy on merge, so the two ship together —
    //     the rosterOverridesPublic contract.
    //
    // `contractTemplates` (generic agreement prose, no per-person data)
    // opened with the contract surfaces (build-plan step 4), which is when
    // something first reads it — its rules live at the end of this section.

    // The roster doc: name, instrument, section, seat — what an orchestra
    // prints in a program. Still staff-only: "publicly-safe fields" is a
    // statement about which FIELDS may someday feed a projection, not a
    // read grant. Pay and contact details are structurally impossible here
    // (the allowlist has no such keys).
    match /personnel/{doc} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly([
             'name', 'preferredName', 'pronunciation', 'instrument',
             'doubles', 'section', 'seat', 'sectionLeader', 'ensembleIds',
             'status', 'notes', 'updatedAt', 'updatedBy', 'updatedByRole',
           ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.status in ['Contracted', 'SubList', 'Inactive'];
      // Deleting a person a contract points at orphans the contract — the
      // app should archive (status: 'Inactive') instead once contracts
      // exist. The rule still allows staff deletes because rules cannot
      // query for referencing contracts, and a mistyped brand-new record
      // must be removable.
      allow delete: if isStaff();
    }

    // Private contact + payroll-adjacent details (doc id === personnel id):
    // address, phone, emergency contact, union local, W-9 STATUS. The
    // allowlist is the no-TIN guarantee — there is no key a taxpayer id
    // could ride in on, and adding one requires editing this file in a
    // reviewed change. `extra` (map of unrecognized import columns) is the
    // one open surface; rules cannot see inside a map, so the importer is
    // responsible for never mapping a TIN-looking column into it.
    //
    // No exists(/personnel/…) anchor on purpose: the roster doc and its
    // contact doc are created in one batch (the students/contacts pattern),
    // and exists() evaluates pre-batch state — the anchor would reject
    // exactly the atomic create we want. Staff-only writes don't need the
    // anchor the way the unauthenticated creates above do.
    match /personnelContacts/{doc} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly([
             'email', 'phone', 'address', 'emergencyName', 'emergencyPhone',
             'unionLocal', 'w9Status', 'extra',
           ])
        && (!('w9Status' in request.resource.data)
            || request.resource.data.w9Status in ['not-requested', 'requested', 'on-file']);
      allow delete: if isStaff();
    }

    // Shape guard for /contracts — create and update both run it.
    // `is int`, not `is number`, on baseRateCents: money is INTEGER CENTS
    // everywhere in this module (types.ts), and the rule makes a
    // floating-point dollar amount physically unwritable. Line-item amounts
    // live inside a list, which rules cannot reach into — the same
    // limitation as `answersJson`, accepted for the same reason.
    function contractShapeOk() {
      return request.resource.data.keys().hasOnly([
           'personnelId', 'personnelName', 'category', 'position',
           'section', 'seat', 'ensembleIds', 'eventIds',
           'startDate', 'endDate', 'season',
           'baseRateCents', 'baseRateBasis', 'baseRateQuantity',
           'lineItems', 'termsText', 'templateId', 'templateVersion',
           'status', 'signature', 'signedAt',
           'countersignedBy', 'countersignedAt', 'notes',
           'createdAt', 'updatedAt', 'updatedBy', 'updatedByRole',
         ])
        && request.resource.data.personnelId is string
        && request.resource.data.personnelName is string
        && request.resource.data.category in ['chair', 'podium', 'staff']
        && request.resource.data.baseRateCents is int
        && request.resource.data.baseRateBasis in ['per-service', 'per-week', 'hourly', 'flat']
        && request.resource.data.status in ['Draft', 'Sent', 'Signed', 'Countersigned', 'Void'];
    }

    // Contracts: the most sensitive collection in the app — pay, and the
    // record of what was agreed. Reads and writes are Owner/Director only;
    // on top of that, the LIFECYCLE is enforced here rather than trusted to
    // the client, because a contract is a legal record, not app state:
    //   • Draft/Sent — a working document; staff edit freely (a typo found
    //     after sending is fixed and re-sent, the signature is what
    //     freezes).
    //   • Signed/Countersigned — the agreed terms (rate, line items, dates,
    //     prose) are FROZEN. Only the lifecycle fields may move, and status
    //     only forward or to Void — no un-signing, and no quiet edit of a
    //     rate someone already signed against.
    //   • Void — terminal. The record stays (it is part of the season's
    //     history and of any dispute); only the internal note may change.
    //     Status is absent from the allowed-keys list, so a Void contract
    //     can never be revived.
    match /contracts/{doc} {
      allow read: if isStaff();
      allow create: if isStaff() && contractShapeOk();
      allow update: if isStaff() && contractShapeOk()
        && (resource.data.status in ['Draft', 'Sent']
            || (resource.data.status in ['Signed', 'Countersigned']
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                     'status', 'countersignedBy', 'countersignedAt',
                     'notes', 'updatedAt', 'updatedBy', 'updatedByRole'])
                && request.resource.data.status in ['Signed', 'Countersigned', 'Void'])
            || (resource.data.status == 'Void'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                     'notes', 'updatedAt', 'updatedBy', 'updatedByRole'])));
      // Only a Draft — never shown to anyone — may be deleted. Everything
      // past Draft was communicated and is a record: void it instead.
      // (Admin SDK bypasses rules for true cleanup, e.g. demo reseeds.)
      allow delete: if isStaff() && resource.data.status == 'Draft';
    }

    // Reusable agreement prose (`ContractTemplate` in types.ts) — the
    // skeleton contracts are issued FROM. Carries no per-person data and no
    // money (numbers stay in the contract's structured fields; the prose
    // only holds {{placeholder}} tokens), but it is still #personnel-tier
    // Owner/Director-only: what an org offers its musicians is nobody
    // else's read, and a poisoned template would flow into every contract
    // issued after. Same exact-allowlist posture as its siblings.
    //
    // Deleting or editing a template never reaches issued contracts —
    // they carry a frozen COPY of the prose (termsText) plus
    // templateId/templateVersion for provenance — so templates get plain
    // staff CRUD with no lifecycle of their own. `version` is a bumped-on-
    // edit int the app stamps onto contracts at issue; `is int >= 1` keeps
    // a garbage version from muddying that provenance.
    match /contractTemplates/{doc} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly([
             'name', 'category', 'bodyText', 'version',
             'updatedAt', 'updatedBy',
           ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.category in ['chair', 'podium', 'staff']
        && request.resource.data.bodyText is string
        && request.resource.data.bodyText.size() <= 20000
        && request.resource.data.version is int
        && request.resource.data.version >= 1;
      allow delete: if isStaff();
    }

    // Attendance at services for the paid roster (`ServiceAttendance` in
    // types.ts) — the build-plan Step 5 collection, PARALLEL to the student
    // `attendance` block above on purpose.
    //
    // Tier decision: Owner/Director ONLY (isStaff()), like every #personnel
    // sibling — NOT the assistant-writable student attendance tier. Marks at
    // services are what per-service contracts settle pay against
    // (Contract.baseRateQuantity), which makes them pay-adjacent; keeping
    // paid-roster data out of the assistant-writable rules is the reason
    // Option B (a parallel collection) was chosen over widening
    // AttendanceRecord. If a real Personnel Manager role ever needs to take
    // roll without full director access, that is a deliberate
    // isKnownRole()-style edit — a new role plus its own rules here — never
    // a default widening.
    //
    // The doc id must equal `eventId + '__' + personnelId` (the calendarViews
    // doc-id-matches-contents pattern): rules cannot enforce uniqueness by
    // query, but a deterministic id makes a second record for the same
    // person at the same service structurally impossible, and two services
    // on the same day stay independent because the id carries the EVENT, not
    // the date. No public mirror exists or may be added, and
    // scripts/generate-feeds.mjs never reads this collection.
    match /serviceAttendance/{doc} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly([
             'personnelId', 'eventId', 'status',
             'updatedAt', 'updatedBy', 'updatedByRole',
           ])
        && request.resource.data.personnelId is string
        && request.resource.data.eventId is string
        && doc == request.resource.data.eventId + '__' + request.resource.data.personnelId
        && request.resource.data.status in ['Present', 'Absent', 'Excused'];
      // Clearing a mark back to "unmarked" IS the delete path (tapping the
      // active status again) — plain staff delete, no lifecycle.
      allow delete: if isStaff();
    }

    // ── Director allowlist (stored as data) ─────────────
    // Owner-only management (#roles): only the Owner may add/remove a
    // director, change a role, or even list the roster — closes the gap
    // where any signed-in director could see or edit who has access. Two
    // narrow self-service exceptions keep the app usable day-to-day:
    //   • a signed-in user may always GET their own doc (to discover
    //     whether they're a director — the app gates access on this);
    //   • a director may UPDATE only `name` and/or `assignedStudentIds` on
    //     their OWN doc — auto-captured display name on first sign-in, and a
    //     Teacher adjusting their own "students assigned to me" list.
    match /directors/{email} {
      // verifiedSelf, not a raw email match: the self-service paths must
      // clear the same verified-email bar as everything else, or a forged
      // unverified claim to an allowlisted address could read the doc and
      // poison `name` (which stamps updatedBy/rollTaken attribution).
      allow get:  if verifiedSelf(email) || isOwner();
      allow list: if isOwner();
      // Existing directors are seeded out-of-band (Admin SDK bypasses these
      // rules); from here on, only the Owner adds or edits others.
      allow create: if isOwner();
      allow update: if isOwner()
        || (verifiedSelf(email)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'assignedStudentIds']));
      // The Owner may remove any OTHER director, but never their own
      // account — the app can never end up ownerless.
      allow delete: if isOwner() && request.auth.token.email != email;
    }

    // ── Sign-in log (#login-history) ────────────────────
    // One receipt per staff sign-in (all roles), written by the app the
    // moment access is confirmed. Anyone on the directors list may append
    // their OWN receipt; only the Owner may read the log (Directors screen →
    // Sign-in history). Nobody edits or deletes — it's an audit trail.
    match /loginEvents/{doc} {
      allow read: if isOwner();
      // `role` must MATCH the directors doc, not whatever the client claims
      // (audit rec #5): an audit trail that lets the audited party pick their
      // own label is not an audit trail. `name` stays client-supplied and is
      // display-only — it is the resolved display name, which has no
      // server-side source of truth (it can fall back to the Google account
      // name), so it is never used for access decisions anywhere.
      allow create: if isKnownRole()
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'at'])
        && request.resource.data.email == request.auth.token.email
        && roleClaimValid(request.resource.data.role)
        && request.resource.data.at is number;
      allow update, delete: if false;
    }

    // ── Activity log (#activity-log) ────────────────────
    // One entry per notable action (opened Schedule, opened Roster, saved a
    // rehearsal note, …) — a parallel, equally append-only log to loginEvents
    // above, kept separate so that collection's narrower shape never has to
    // change. Anyone on the directors list may append their OWN entry; only
    // the Owner may read the log (Directors screen → Activity log).
    match /activityLog/{doc} {
      allow read: if isOwner();
      // Same as loginEvents: `role` is verified against the directors doc,
      // `name` is display-only (audit rec #5).
      allow create: if isKnownRole()
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'action', 'detail', 'at'])
        && request.resource.data.email == request.auth.token.email
        && roleClaimValid(request.resource.data.role)
        && request.resource.data.action is string
        && request.resource.data.at is number;
      allow update, delete: if false;
    }

    // ── Deny everything else by default ─────────────────
    match /{document=**}         { allow read, write: if false; }
  }
}
