rules_version = '2';

// NWSA Music Hub — Firestore security rules
//
// Two tiers of data:
//   • PUBLIC collections are world-readable (they power the public site:
//     schedules, repertoire, announcements). They contain no private contact
//     info. Only staff (Owner/Director) may write them.
//   • PRIVATE collections (full student records, contact details, attendance
//     exceptions, progress notes, private lessons) are readable and writable
//     only by signed-in staff — never world-readable.
//
// Student privacy (#privacy): the full `students` and `rosterOverrides`
// collections are staff-only. The public site reads projection mirrors
// instead — `studentsPublic` (name, preferred name, instrument, section,
// ensembles, status, grade; NEVER pronunciation or contacts) and
// `rosterOverridesPublic` (every field EXCEPT the free-text reason).
// Mirrors are batched with each write (src/director/publicMirror.ts) and
// converged by scripts/backfill-public-projections.mjs via the Admin SDK.
//
// Four access levels (#roles), stored on each directors/{email} doc's
// `role` field:
//   • owner     — exactly one account. The only one that can add/remove a
//                 director or change anyone's role.
//   • director  — full edit access to everything except the Directors list.
//   • teacher   — scoped to scheduling their OWN private lessons (see
//                 `lessons` and the `kind == 'lesson'` exception on
//                 `rosterOverrides` below). Can't touch rosters, schedule,
//                 repertoire, documents, announcements, contacts, or the
//                 Directors list.
//   • assistant — Personnel Assistant: reads/writes ATTENDANCE only, and only
//                 for the ensembles named in their doc's `assignedEnsembleIds`
//                 (plus the narrow side-effects of taking roll: the event's
//                 rollTaken receipt, lesson pull-out overrides, and reading
//                 planned absences). Never contacts, notes, grades, or any
//                 public-collection write.
// A doc with no `role` predates this feature and is treated as a full
// director (see isStaff()) — nobody with existing access loses it. An
// EXPLICIT but unrecognized role is fail-closed: beyond reading and
// renaming its own directors doc, it can touch nothing (every data rule
// requires one of the four roles above — see isKnownRole()). A future
// fifth role must be added to these rules deliberately before its
// accounts gain any access.
//
// The AI enrichment GitHub Action authenticates with a service account via the
// Admin SDK, which bypasses these rules entirely — so enrichment writes work
// regardless of what's below.
//
// Deploy with:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function myDirectorDoc() {
      return get(/databases/$(database)/documents/directors/$(request.auth.token.email)).data;
    }

    // A director is an authenticated user who has a doc in the `directors`
    // collection (doc id = their lowercased Google sign-in email). Google
    // sign-in lets ANY Google account authenticate, so checking only
    // `request.auth != null` would expose student contact info, attendance,
    // and progress notes to anyone who finds the URL.
    //
    // The allowlist lives in DATA (see the `directors` match block below), not
    // in this file — so a director is added or removed from inside the app with
    // NO rules redeploy. That closes the old trap where the app's sign-in mirror
    // shipped automatically but this file had to be deployed by hand, leaving a
    // newly-added director able to open the app but unable to save.
    // email_verified: Google sign-in always verifies, so this costs existing
    // accounts nothing — it only closes the door on a future auth provider
    // (or a forged federated account) presenting an unverified claim to an
    // email that happens to be on the allowlist.
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/directors/$(request.auth.token.email));
    }

    // Same verified-email bar as signedIn(), minus the allowlist existence
    // check — for the directors block's self-service paths, where the doc
    // being read IS the membership answer (a clean "not a director" must
    // surface as doc-not-exists, never as permission-denied).
    function verifiedSelf(email) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == email;
    }

    // The Owner: the one account allowed to manage the Directors list itself.
    function isOwner() {
      return signedIn() && myDirectorDoc().role == 'owner';
    }

    function isTeacherRole() {
      return signedIn() && myDirectorDoc().role == 'teacher';
    }

    // Personnel Assistant (#roles): attendance-only, for assigned ensembles.
    function isAssistantRole() {
      return signedIn() && myDirectorDoc().role == 'assistant';
    }

    // Is `ensembleId` one of the signed-in assistant's assigned ensembles?
    function assistantCovers(ensembleId) {
      return isAssistantRole()
        && ensembleId in myDirectorDoc().get('assignedEnsembleIds', []);
    }

    // Full director privileges: Owner, Director, or a legacy doc with no
    // role set (every director created before roles existed — the default
    // fills in 'director' for those). Fail-CLOSED for anything else,
    // instead of silently inheriting full director rights the way the old
    // "not teacher && not assistant" check did.
    function isStaff() {
      return signedIn()
        && myDirectorDoc().get('role', 'director') in ['owner', 'director'];
    }

    // Any of the four recognized roles (legacy no-role docs count as
    // director). Shared-tier rules below are gated on THIS, never on bare
    // signedIn(), so an explicit unknown role gets nothing: a future fifth
    // role must be added here deliberately before its accounts can read
    // students, rosters, or logs.
    function isKnownRole() {
      return signedIn()
        && myDirectorDoc().get('role', 'director') in ['owner', 'director', 'teacher', 'assistant'];
    }

    // ── Public read · staff write ────────────────────
    match /ensembles/{doc}       { allow read; allow write: if isStaff(); }
    // Full student records (pronunciation, …) are staff-eyes only
    // (#privacy). Every recognized role may READ them — teachers need
    // names for lessons, assistants need pronunciation for roll — but the
    // public site gets only the studentsPublic projection below.
    match /students/{doc}        { allow read: if isKnownRole(); allow write: if isStaff(); }
    // Public projection of the roster: name, preferredName, instrument,
    // section, ensembleIds, status, grade — nothing else. Written in the same
    // batch as the source doc by staff clients.
    match /studentsPublic/{doc} {
      allow read;
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(
             ['name', 'preferredName', 'instrument', 'section', 'ensembleIds', 'status', 'grade']);
      allow delete: if isStaff();
    }
    // events: staff edit freely. A Personnel Assistant may update ONLY the
    // rollTaken receipt (the side-effect of finishing roll) — never the
    // schedule itself — and only the receipt entries for THEIR ensembles.
    match /events/{doc} {
      allow read;
      allow create, delete: if isStaff();
      allow update: if isStaff()
        || (isAssistantRole()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rollTaken'])
            && request.resource.data.rollTaken
                 .diff(resource.data.get('rollTaken', {}))
                 .affectedKeys()
                 .hasOnly(myDirectorDoc().get('assignedEnsembleIds', [])));
    }
    // Saved calendar views (#subscribe-any-view): the filter mixes the deploy
    // step turns into subscribable ICS feeds. World-readable, and written by
    // ANYONE — a student picking their own three ensembles on the public
    // calendar is the main audience, and a live subscription for that mix is
    // the entire point of the feature, so this is an unauthenticated create
    // like plannedAbsences and parentMessages, with the same strictest-
    // validation treatment: exact key set, closed type enum, bounded lists
    // and label.
    //
    // A view doc carries no personal information — a list of ensemble ids and
    // event types, all of them already world-readable. Two structural guards
    // do the rest of the work:
    //   • the doc ID is a hash of the filters themselves (viewSlug), so
    //     re-subscribing to the same mix rewrites ONE doc instead of piling
    //     up new ones;
    //   • generate-feeds.mjs recomputes that hash and ignores any doc whose
    //     ID does not match its own contents, so a squatted ID can only ever
    //     hold the correct filters — and the next real subscriber overwrites
    //     it (hence create AND update).
    // Volume rate-limiting still needs App Check or a Cloud Function and is
    // deferred, matching the stance on the other public writes
    // (docs/security-recommendations.md).
    match /calendarViews/{doc} {
      allow read;
      allow delete: if isStaff();
      allow create, update: if request.resource.data.keys().hasOnly(
            ['ensembleIds', 'school', 'types', 'label', 'updatedAt'])
        && request.resource.data.ensembleIds is list
        && request.resource.data.ensembleIds.size() <= 40
        && request.resource.data.school is bool
        && request.resource.data.types is list
        && request.resource.data.types.size() <= 12
        && request.resource.data.types.hasOnly(
             ['Class', 'Rehearsal', 'Sectional', 'Concert', 'Event', 'Assignment'])
        && request.resource.data.label is string
        && request.resource.data.label.size() <= 200
        && request.resource.data.updatedAt is number;
    }
    // rosterOverrides: staff can write anything. A Teacher may create/edit/
    // delete only THEIR OWN private-lesson pull-outs (kind == 'lesson') — the
    // automatic side effect of scheduling a lesson that conflicts with a
    // rehearsal/class (see the `lessons` collection below). Teachers never
    // touch ordinary subs/pull-outs or another teacher's lesson entries.
    // A Personnel Assistant gets the same lesson-only exception (the Lesson
    // button on Take Roll records a pull-out window) — scoped to the
    // ensembles they cover.
    match /rosterOverrides/{doc} {
      // Staff-only reads (#privacy): override docs carry a free-text `reason`
      // directors may fill with sensitive context. The public site reads the
      // reason-free rosterOverridesPublic mirror below instead.
      allow read: if isKnownRole();
      allow create: if isStaff()
        || (isTeacherRole() && request.resource.data.kind == 'lesson')
        || (request.resource.data.kind == 'lesson' && assistantCovers(request.resource.data.ensembleId));
      allow update: if isStaff()
        || (isTeacherRole() && resource.data.kind == 'lesson' && request.resource.data.kind == 'lesson')
        || (resource.data.kind == 'lesson' && request.resource.data.kind == 'lesson'
            && assistantCovers(resource.data.ensembleId)
            && request.resource.data.ensembleId == resource.data.ensembleId);
      allow delete: if isStaff()
        || (isTeacherRole() && resource.data.kind == 'lesson')
        || (resource.data.kind == 'lesson' && assistantCovers(resource.data.ensembleId));
    }
    // Reason-free public mirror of rosterOverrides (#privacy): the public
    // student-schedule page shows lesson pull-out windows and sub/pull roster
    // effects from here. Writers are the same clients that write the source
    // collection (all allowlisted roles — teachers and assistants create
    // lesson pull-outs); the shape check makes a leaked `reason` impossible
    // regardless of client code.
    // Public projection of roster overrides: every field EXCEPT the free-text
    // `reason`. The key list is FROZEN here, mirroring publicOverrideFields()
    // in src/director/publicMirror.ts — denying `reason` alone left any
    // recognized role (teachers and assistants write lesson pull-outs here)
    // able to add arbitrary extra keys to a world-readable doc (audit rec #3).
    // Adding a field to RosterOverride now means adding it here in the same
    // change; rules auto-deploy on merge to main, so the two ship together.
    match /rosterOverridesPublic/{doc} {
      allow read;
      allow create, update: if isKnownRole()
        && request.resource.data.keys().hasOnly([
             'studentId', 'ensembleId', 'action', 'scope',
             'eventId', 'startDate', 'endDate',
             'startTime', 'endTime', 'kind', 'destEnsembleId',
           ]);
      allow delete: if isKnownRole();
    }
    match /announcements/{doc}   { allow read; allow write: if isStaff(); }
    match /repertoire/{doc}      { allow read; allow write: if isStaff(); }
    // Assignment DEFINITIONS (title, type, due date, target) are public so
    // students see what's assigned. Individual RESULTS/grades stay private below.
    match /assignments/{doc}     { allow read; allow write: if isStaff(); }
    match /seatingCharts/{doc}   { allow read; allow write: if isStaff(); }
    match /locations/{doc}       { allow read; allow write: if isStaff(); }
    // Document repository (syllabi, handbooks, forms). Metadata is public so the
    // Documents page and per-ensemble lists can render; the files themselves
    // live in Storage. Only staff may add/edit/remove entries.
    match /documents/{doc}       { allow read; allow write: if isStaff(); }

    // Planned absences (#27): anyone may SUBMIT one (create-only, shape-checked),
    // but only staff can read the queue or change/delete entries — so the
    // public side can't enumerate or tamper with other students' reports.
    match /plannedAbsences/{doc} {
      // Hardened shape (audit S4): the student must actually exist (no
      // spam-for-invented-ids), the date must be a real YYYY-MM-DD string,
      // and every free-text field is size-bounded — this is the one
      // unauthenticated write in the whole app, so it gets the strictest
      // validation.
      allow create: if request.resource.data.keys().hasOnly(['studentId', 'studentName', 'date', 'reason', 'submittedAt', 'status'])
        && request.resource.data.studentId is string
        && exists(/databases/$(database)/documents/students/$(request.resource.data.studentId))
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() <= 120
        && request.resource.data.date is string
        && request.resource.data.date.matches('\\d{4}-\\d{2}-\\d{2}')
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 300
        && request.resource.data.submittedAt is number
        && request.resource.data.status == 'pending';
      // Assistants read the queue too — Take Roll shows "reported ahead"
      // chips so they can accept a planned absence as Excused.
      allow read: if isStaff() || isAssistantRole();
      allow update, delete: if isStaff();
    }

    match /parentMessages/{doc} {
      // Parent→staff contact form (#parent-messages): an unauthenticated
      // create (like plannedAbsences and assignmentSubmissions), so it
      // gets the same strictest-validation
      // treatment as plannedAbsences — exact key set, closed topic enum,
      // size floors AND ceilings on every free-text field. keys().hasOnly
      // doubles as the honeypot: the form only includes its hidden decoy
      // field when a bot fills it, and the create is rejected here.
      // Deliberately NO students/{id} anchor — prospective families (no
      // student doc yet) are a primary audience for this form. Real rate
      // limiting needs App Check or a Cloud Function (Blaze) and is
      // deferred, matching the plannedAbsences stance
      // (docs/security-recommendations.md).
      allow create: if request.resource.data.keys().hasOnly(
            ['parentName', 'email', 'studentName', 'topic', 'message', 'submittedAt', 'status'])
        && request.resource.data.parentName is string
        && request.resource.data.parentName.size() >= 2
        && request.resource.data.parentName.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('.+@.+\\..+')
        && (!('studentName' in request.resource.data)
            || (request.resource.data.studentName is string
                && request.resource.data.studentName.size() <= 120))
        && request.resource.data.topic in
            ['attendance', 'schedule', 'lessons', 'concerts', 'volunteer', 'enrollment', 'other']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 1000
        && request.resource.data.submittedAt is number
        && request.resource.data.status == 'new';
      allow read: if isStaff();
      allow update, delete: if isStaff();
    }

    // Outbound notification queue (#21): staff-only writes; Power Automate
    // reads it with a service credential (Admin SDK bypasses rules).
    match /notifyQueue/{doc}     { allow read, write: if isStaff(); }
    // Ambiguous rows from the daily office Attendance Bulletin (Admin SDK
    // writes; directors read / dismiss / resolve in Who's Out).
    match /bulletinQueue/{doc}   { allow read, write: if isStaff(); }

    // Private lessons (#roles): a Teacher schedules/edits/cancels their OWN
    // lessons; Owner/Director can see and manage all of them (coordination —
    // e.g. confirming a conflict with the ensemble director). Never world-
    // readable, since it names an individual student and their teacher.
    match /lessons/{doc} {
      // Not plain signedIn(): a Personnel Assistant is attendance-only and
      // has no business reading who takes private lessons with whom.
      //
      // A Teacher reads only their OWN lessons (audit rec #5) — every teacher
      // could previously read every other teacher's schedule. Rules match per
      // document, so a LIST for a teacher only succeeds if the query itself
      // filters to teacherEmail == their address; useLessons.ts issues exactly
      // that query for the teacher role. Owner/Director still read all of it
      // for coordination.
      allow read: if isStaff()
        || (isTeacherRole() && resource.data.teacherEmail == request.auth.token.email);
      allow create: if isStaff() || (isTeacherRole() && request.resource.data.teacherEmail == request.auth.token.email);
      allow update, delete: if isStaff() || (isTeacherRole() && resource.data.teacherEmail == request.auth.token.email);
    }

    // ── Private · staff read + write only ──────────────
    match /contacts/{doc}           { allow read, write: if isStaff(); }
    // attendance: staff freely; a Personnel Assistant reads all (roll needs
    // same-day context across periods) but writes only records for THEIR
    // assigned ensembles.
    match /attendance/{doc} {
      allow read: if isStaff() || isAssistantRole();
      allow create: if isStaff() || assistantCovers(request.resource.data.ensembleId);
      // Update: the record must belong to a covered ensemble AND stay there —
      // an assistant can't re-home a record into an ensemble they don't cover.
      allow update: if isStaff()
        || (assistantCovers(resource.data.ensembleId)
            && request.resource.data.ensembleId == resource.data.ensembleId);
      allow delete: if isStaff() || assistantCovers(resource.data.ensembleId);
    }
    match /progressNotes/{doc}      { allow read, write: if isStaff(); }
    match /assignmentResults/{doc}  { allow read, write: if isStaff(); }

    // ── Student video submissions (#video-submissions) ──
    // Students submit video recordings/upload for Playing Exam assignments
    // from the public site (unauthenticated). Staff review them in the
    // grade sheet. A cron GitHub Action syncs them to Google Drive.
    match /assignmentSubmissions/{doc} {
      allow read: if isStaff();
      // Unauthenticated create with strict shape validation — same pattern
      // as plannedAbsences: must reference a real assignment that accepts
      // video, a real student from that assignment's ensembles, and
      // every field is size-bounded.
      allow create: if request.resource.data.keys().hasOnly([
            'assignmentId', 'studentId', 'studentName', 'status',
            'videoUrl', 'videoDurationSeconds', 'videoThumbnailUrl',
            'fileName', 'fileSize', 'notes', 'submittedAt',
            'googleDriveFileId', 'googleDriveFolderId',
          ])
        && request.resource.data.assignmentId is string
        && exists(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId))
        && get(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId)).data.acceptsVideoSubmissions == true
        && request.resource.data.studentId is string
        && exists(/databases/$(database)/documents/students/$(request.resource.data.studentId))
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() <= 120
        && request.resource.data.status == 'submitted'
        && request.resource.data.videoUrl is string
        && request.resource.data.videoUrl.size() <= 1024
        // >= 0, not > 0: a browser cannot always read the length of a video
        // file a student picked from their phone, and 0 means "unknown", not
        // "empty". Requiring a positive number here is what made every upload
        // (and, before the recorder's timer was fixed, every recording) fail
        // with "Missing or insufficient permissions". File size below still
        // has to be positive, which is the check that actually proves a video.
        && request.resource.data.videoDurationSeconds is number
        && request.resource.data.videoDurationSeconds >= 0
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() <= 256
        && request.resource.data.fileSize is number
        && request.resource.data.fileSize > 0
        && request.resource.data.submittedAt is number;
      // Only staff may update (review status, Drive sync fields) or delete.
      allow update, delete: if isStaff();
    }

    // ── Director allowlist (stored as data) ─────────────
    // Owner-only management (#roles): only the Owner may add/remove a
    // director, change a role, or even list the roster — closes the gap
    // where any signed-in director could see or edit who has access. Two
    // narrow self-service exceptions keep the app usable day-to-day:
    //   • a signed-in user may always GET their own doc (to discover
    //     whether they're a director — the app gates access on this);
    //   • a director may UPDATE only `name` and/or `assignedStudentIds` on
    //     their OWN doc — auto-captured display name on first sign-in, and a
    //     Teacher adjusting their own "students assigned to me" list.
    match /directors/{email} {
      // verifiedSelf, not a raw email match: the self-service paths must
      // clear the same verified-email bar as everything else, or a forged
      // unverified claim to an allowlisted address could read the doc and
      // poison `name` (which stamps updatedBy/rollTaken attribution).
      allow get:  if verifiedSelf(email) || isOwner();
      allow list: if isOwner();
      // Existing directors are seeded out-of-band (Admin SDK bypasses these
      // rules); from here on, only the Owner adds or edits others.
      allow create: if isOwner();
      allow update: if isOwner()
        || (verifiedSelf(email)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'assignedStudentIds']));
      // The Owner may remove any OTHER director, but never their own
      // account — the app can never end up ownerless.
      allow delete: if isOwner() && request.auth.token.email != email;
    }

    // ── Sign-in log (#login-history) ────────────────────
    // One receipt per staff sign-in (all roles), written by the app the
    // moment access is confirmed. Anyone on the directors list may append
    // their OWN receipt; only the Owner may read the log (Directors screen →
    // Sign-in history). Nobody edits or deletes — it's an audit trail.
    match /loginEvents/{doc} {
      allow read: if isOwner();
      // `role` must MATCH the directors doc, not whatever the client claims
      // (audit rec #5): an audit trail that lets the audited party pick their
      // own label is not an audit trail. `name` stays client-supplied and is
      // display-only — it is the resolved display name, which has no
      // server-side source of truth (it can fall back to the Google account
      // name), so it is never used for access decisions anywhere.
      allow create: if isKnownRole()
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'at'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == myDirectorDoc().get('role', 'director')
        && request.resource.data.at is number;
      allow update, delete: if false;
    }

    // ── Activity log (#activity-log) ────────────────────
    // One entry per notable action (opened Schedule, opened Roster, saved a
    // rehearsal note, …) — a parallel, equally append-only log to loginEvents
    // above, kept separate so that collection's narrower shape never has to
    // change. Anyone on the directors list may append their OWN entry; only
    // the Owner may read the log (Directors screen → Activity log).
    match /activityLog/{doc} {
      allow read: if isOwner();
      // Same as loginEvents: `role` is verified against the directors doc,
      // `name` is display-only (audit rec #5).
      allow create: if isKnownRole()
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'action', 'detail', 'at'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == myDirectorDoc().get('role', 'director')
        && request.resource.data.action is string
        && request.resource.data.at is number;
      allow update, delete: if false;
    }

    // ── Deny everything else by default ─────────────────
    match /{document=**}         { allow read, write: if false; }
  }
}
