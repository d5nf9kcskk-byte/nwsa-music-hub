# Emulator proof only (project demo-mailkit). The SMTP sink is proof/mail-proof.mjs.
LOCATION=us-central1
FUNCTION_DEFAULT_REGION=us-central1
DATABASE=(default)
DATABASE_REGION=nam5
AUTH_TYPE=UsernamePassword
MAIL_COLLECTION=mail
TTL_EXPIRE_TYPE=never
TTL_EXPIRE_VALUE=1
SMTP_CONNECTION_URI=smtp://kituser@127.0.0.1:2525
DEFAULT_FROM=Atlanta International Symphony Orchestra <info@aisymphonyorchestra.org>
DEFAULT_REPLY_TO=info@aisymphonyorchestra.org
OAUTH_PORT=587
OAUTH_SECURE=false
