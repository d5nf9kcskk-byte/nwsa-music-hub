# School (nwsa-hub). From extensions/firestore-send-email.env; replace with ext:export output at go-live.
LOCATION=us-central1
FUNCTION_DEFAULT_REGION=us-central1
DATABASE=(default)
DATABASE_REGION=nam5
AUTH_TYPE=UsernamePassword
MAIL_COLLECTION=mail
TTL_EXPIRE_TYPE=never
TTL_EXPIRE_VALUE=1
FIREBASE_SECRET_REF_SMTP_PASSWORD=firestore-send-email-SMTP_PASSWORD
SMTP_CONNECTION_URI=smtps://nwsaorchestras@gmail.com@smtp.gmail.com:465
DEFAULT_FROM=nwsaorchestras@gmail.com
DEFAULT_REPLY_TO=nwsaorchestras@gmail.com
OAUTH_PORT=465
OAUTH_SECURE=true
