rules_version = '2';

// NWSA Music Hub — Firebase Storage security rules
//
// Uploaded files back two public features: assignment attachments and the
// document repository (syllabi, handbooks, forms) — plus, since Aug 2026,
// concert check-in selfies, which are the one path here that is NOT
// world-readable (see the /checkins block). The files are world-
// READABLE (their links are already public in Firestore), and only a
// director/owner may upload, overwrite, or delete them (Teachers are scoped
// to lesson scheduling only — see firestore.rules — and don't get Storage
// access).
//
// The allowlist is NOT hardcoded here (that was the bug: a director added
// in-app via the Directors screen could sign in and save to Firestore, but
// every upload silently failed with "storage/unknown" because this file
// still only knew about the original seed email). Instead this reads the
// SAME `directors` collection in Firestore that firestore.rules uses, via
// Storage's cross-service firestore.get()/exists() — one allowlist, one
// place to manage it (the in-app Directors screen), no rules redeploy to
// grant a new director Storage access ever again.
//
// Deploy with:  firebase deploy --only storage

service firebase.storage {
  match /b/{bucket}/o {

    function directorDoc() {
      return firestore.get(/databases/(default)/documents/directors/$(request.auth.token.email)).data;
    }

    // Signed in AND listed in Firestore's `directors` collection — mirrors
    // firestore.rules' isStaff(). Owner and Director get full Storage access
    // (a legacy doc with no role counts as director); every other role is
    // fail-closed. The old check only excluded 'teacher', which let a
    // Student Assistant — attendance-scoped by design — upload, overwrite,
    // or delete the world-readable documents and assignment files (audit S5).
    function hasRole(r) {
      let d = directorDoc();
      return (d.keys().hasAny(['roles']) && r in d.get('roles', []))
        || (!d.keys().hasAny(['roles']) && d.get('role', 'director') == r);
    }

    function isClassroom() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/directors/$(request.auth.token.email))
        && hasRole('classroom');
    }

    function isStaff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/directors/$(request.auth.token.email))
        && (hasRole('owner') || hasRole('director'));
    }

    // ponytail: Storage paths don't encode ensemble — Firestore doc writes
    // are scoped; classroom teachers need to attach syllabi and assignments.
    function mayUploadStaffFiles() {
      return isStaff() || isClassroom();
    }

    // Size ceiling for staff uploads: handbooks, syllabi, scores, and forms.
    // Nothing here used to be bounded at all (audit rec #6) — one mis-picked
    // 4 GB video would have been accepted and billed. Content types stay open
    // on purpose: directors legitimately upload PDFs, images, Office docs,
    // MusicXML, and audio, and these paths are staff-only anyway.
    function withinStaffSize() {
      return request.resource == null || request.resource.size < 50 * 1024 * 1024;
    }

    // Assignment attachments and document-repository files.
    match /assignments/{allPaths=**} { allow read; allow write: if mayUploadStaffFiles() && withinStaffSize(); }
    match /documents/{allPaths=**}   { allow read; allow write: if mayUploadStaffFiles() && withinStaffSize(); }

    // Pictures and files attached to an announcement. World-readable for the
    // same reason as the two paths above: the post that points at them is
    // itself world-readable (`announcements` in firestore.rules is `allow
    // read`), so the file is public the moment it is attached. Same 50 MB
    // staff ceiling; same open content types (a director attaches a photo,
    // a PDF, or a Word form).
    match /announcements/{allPaths=**} { allow read; allow write: if mayUploadStaffFiles() && withinStaffSize(); }

    // Student video submissions (#video-submissions). World-readable so the
    // director can stream them in the grade sheet and the cron sync can
    // download them. Unauthenticated write is allowed only for video files
    // under the submissions path — the Firestore doc write (which validates
    // the assignment exists and accepts video) gates access in practice.
    //
    // The size ceiling is the one the DIRECTOR set on that assignment
    // (`maxVideoSizeMB`, shown in the form in MB), read across services from
    // the assignment doc, falling back to 500 MB when unset. Enforcing it here
    // rather than only in the upload form means the limit is real: the path is
    // submissions/{assignmentId}/{studentId}/{file}, so the assignment is
    // known. A submission for an assignment that does not exist is refused —
    // and, since studentId is now its own path segment, so is one for a
    // student who does not exist: the Firestore write below already anchors
    // assignmentSubmissions.studentId to a real students/{id}, but the Storage
    // object was uploadable first, so nothing stopped a caller from parking a
    // video under an invented or someone-else's id before that write ever ran
    // (or without it running at all). Checked against the staff-only
    // `students` collection, not the public mirror: firestore.exists() from
    // Storage rules bypasses Firestore rules entirely (same cross-service read
    // isStaff() above already relies on), so there's no reason to read the
    // narrower projection.
    match /submissions/{assignmentId}/{studentId}/{allPaths=**} {
      allow read;
      allow create: if firestore.exists(/databases/(default)/documents/assignments/$(assignmentId))
        && firestore.exists(/databases/(default)/documents/students/$(studentId))
        && request.resource.size < firestore.get(
             /databases/(default)/documents/assignments/$(assignmentId)
           ).data.get('maxVideoSizeMB', 500) * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
      allow update, delete: if isStaff();
    }

    // Temp chunk storage for the client-side chunked resumable upload
    // (#video-upload-reliability Phase 2). The browser uploads each ~16 MiB
    // piece here directly, unauthenticated — same posture as /submissions
    // above. composeSubmission (functions/src/composeSubmission.ts) is the
    // only thing that ever reads one back, through the Admin SDK, which
    // bypasses these rules entirely — so there is NO `allow read` here at
    // all, for anyone, staff included: write-only for the public, closed
    // outright to everyone else. A chunk on its own is not a usable video
    // (GCS compose is what turns a full set of them into the real
    // submissions/ object), so there is nothing to gain by reading one
    // back, and no reason to ever hand out a bearer link to a fragment of
    // an in-progress upload.
    //
    // Same anchors as /submissions: a real assignment, a real student. The
    // size ceiling here bounds ONE chunk only (~16 MiB client-side, plus
    // headroom) — it can never bound the SUM across chunks, which is
    // exactly why composeSubmission re-checks the combined size in real
    // code, against the assignment's actual maxVideoSizeMB, before
    // composing anything.
    //
    // No update/delete path for anyone either: composeSubmission deletes
    // chunks itself (Admin SDK) after a successful compose, and the
    // scheduled cleanup (scripts/cleanup-abandoned-chunks.mjs, also Admin
    // SDK) deletes anything left behind by an upload nobody ever finished.
    match /submissions-parts/{assignmentId}/{studentId}/{sessionId}/{index} {
      allow read, update, delete: if false;
      allow create: if firestore.exists(/databases/(default)/documents/assignments/$(assignmentId))
        && firestore.exists(/databases/(default)/documents/students/$(studentId))
        && request.resource.size < 20 * 1024 * 1024;
    }

    // Concert check-in selfies (#concert-checkin).
    //
    // The one Storage path in this file with NO public read. The assignment,
    // document, and submission paths above are world-readable because their
    // links are already public in Firestore; these are photographs of
    // students taken at a concert door, and no bearer link to one may exist.
    // The CSV export resolves a link for a signed-in director at download
    // time instead.
    //
    // No public WRITE either, unlike /submissions: the concertCheckin Cloud
    // Function uploads through the Admin SDK, which bypasses these rules, so
    // a photo can only ever arrive attached to a record the server itself
    // stamped and validated. A phone never writes here directly.
    match /checkins/{allPaths=**} {
      allow read, write: if isStaff();
    }

    // Deny everything else by default.
    match /{allPaths=**}             { allow read, write: if false; }
  }
}
